# Confluence credentials (required for confluence_page sources)
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_API_TOKEN=your-api-token

# HuggingFace token (required for gated models like EmbeddingGemma)
HF_TOKEN=hf_your-token

# Database (override if not using local Docker)
# DATABASE_URL=postgresql://docforge:localdev@localhost:5432/docforge
